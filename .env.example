# ==========================================
# DayForge Environment Variables Configuration
# ==========================================

# 1. Database Connection (Neon Serverless Postgres)
# Pooled connection string for serverless API execution:
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.neon.tech/neondb?sslmode=require"

# Direct connection string for Prisma migrations & schema push:
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].neon.tech/neondb?sslmode=require"

# 2. Google OAuth 2.0 Credentials (from console.cloud.google.com)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# 3. Application Domain & Security
NEXT_PUBLIC_APP_URL="https://day-forge-alpha.vercel.app"
JWT_SECRET="dayforge_super_secure_jwt_secret_2026_prod"
