# ==========================================
# DayForge — Vercel Environment Variables
# ==========================================

# 1. Backend Security & JWT
# Replace with a strong random secret key (e.g. openssl rand -hex 32)
SECRET_KEY=your-production-secret-key-change-me

# 2. Database Connection (Optional for PostgreSQL / Neon / Supabase)
# If omitted on Vercel, defaults to temporary SQLite at /tmp/dayforge.db
# Example for PostgreSQL: postgresql+asyncpg://user:password@host/dbname
DATABASE_URL=sqlite+aiosqlite:////tmp/dayforge.db

# 3. Frontend Base URL (Optional — defaults to relative /api/v1)
# VITE_API_URL=/api/v1
